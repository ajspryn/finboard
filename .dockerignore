scripts/*
!scripts/db_backup.sh
!scripts/db_restore.sh

# IDE files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ML scripts (Python) – not needed in PHP container
ml/
src/
