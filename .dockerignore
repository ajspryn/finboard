.git
.gitignore
.env
.env.*
!.env.example

# Node modules
node_modules/
npm-debug.log
yarn-error.log

# Test files
tests/
test-data/

# Local development
.vagrant/
Homestead.json
Homestead.yaml
auth.json
phpunit.xml

# Logs & caches
storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
